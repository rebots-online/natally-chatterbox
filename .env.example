# Hosted chat: frontend contains only this public URL, never the provider key.
VITE_CHAT_API_URL="https://natally-hosted-chat.netlify.app/.netlify/functions/chat"
# Public voice defaults, embedded at build time: edit .env then rebuild/redeploy.
# Speaker: F1-F5, M1, M2. Pitch/rate: 0.8-1.4. Pitch also speeds up playback.
# A changed preset migrates saved audio settings while retaining mute/avatar/sprite.
VITE_NATALLY_VOICE="F4"
VITE_NATALLY_VOICE_PITCH="1.15"
VITE_NATALLY_VOICE_RATE="0.90"
# Maximum chunk characters, 100-800; adaptive policy caps at 240 (180 on gentle/slow devices).
VITE_NATALLY_SPEECH_CHUNK_CHARS="240"
# Set these in the hosted function environment only.
ZAI_API_KEY=""
ZAI_MODEL="glm-5.3-flash"
FIREBASE_API_KEY=""
FRONTEND_ORIGIN="https://natally-chatterbox.surge.sh"

# GEMINI_API_KEY: Direct Gemini access (legacy engine; also powers TTS when present).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://natally-chatterbox.surge.sh"

# ── Inference engines ────────────────────────────────────────────────────────
# INFERENCE_ENGINE selects the chat/readings engine:
#   openrouter        — OpenRouter free tier via OPENROUTER_API_KEY (auto-default
#                       when that key is present)
#   gemini            — direct GEMINI_API_KEY access
#   openai-compatible — any OpenAI-shaped endpoint via CUSTOM_LLM_* (z.ai GLM
#                       Coding Plan, Ollama, LM Studio, …)
#   venice            — direct Venice inference via VENICE_API_KEY
#   venice-admin      — reserved: admin-key provisioning of spend-limited user keys
#   openrouter-admin  — reserved: per-user provisioned keys (40% of top-up)
#   local             — reserved: atomic-chat llama.cpp / wllama3, no spend limit
# Unset = auto (openrouter if OPENROUTER_API_KEY present, else gemini).
#INFERENCE_ENGINE="openrouter"

# ── OpenRouter (direct / free tier) ──────────────────────────────────────────
OPENROUTER_API_KEY="sk-or-v1-"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# OPENROUTER_MODEL: optional explicit default model id. Unset = free-tier chain
# (deepseek-chat-v3-0324:free → llama-3.3-70b:free → gemma-3-27b:free) with
# automatic fallback when a free model is delisted or rate-capped.
#OPENROUTER_MODEL="deepseek/deepseek-chat-v3-0324:free"

# ── OpenRouter admin (reserved: provisioning, not used yet) ──────────────────
OPENROUTER_ADMIN_KEY="sk-or-v1-"

# ── Venice.ai ────────────────────────────────────────────────────────────────
VENICE_API_KEY="VENICE_INFERENCE_KEY_"
VENICE_BASE_URL="https://api.venice.ai/api/v1"
# VENICE_MODEL: optional default model slug (unset = venice-uncensored-1-2;
# catalog also carries z-ai-glm-5-3-flash, gemini-3-8-flash, …).
#VENICE_MODEL="venice-uncensored-1-2"
# Admin key (reserved: provisioning, not used yet)
VENICE_ADMIN_KEY="VENICE_ADMIN_KEY_"

# ── Generic OpenAI-compatible endpoint (z.ai / Ollama / LM Studio / …) ───────
# CUSTOM_LLM_BASE_URL: e.g. z.ai GLM Coding Plan "https://api.z.ai/api/coding/paas/v4",
# standard z.ai "https://api.z.ai/api/paas/v4", or Ollama "http://localhost:11434/v1".
#CUSTOM_LLM_BASE_URL="https://api.z.ai/api/coding/paas/v4"
#CUSTOM_LLM_API_KEY="MY_ZAI_OR_OTHER_KEY"        # optional for local Ollama
#CUSTOM_LLM_MODEL="glm-5.3-flash"                # single default model
#CUSTOM_LLM_MODELS="glm-5.3-flash,glm-5.3-air"   # optional comma-separated fallback chain
VITE_NATALLY_MASCOT_URL="/natally-mascot.webp"
VITE_NATALLY_HEADER_SIZE="72"
VITE_NATALLY_SPEAKING_SIZE="112"
