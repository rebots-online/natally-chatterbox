rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validIntake(data) {
      return data.keys().hasAll(['name', 'birthDate', 'birthTime', 'placeName', 'latitude', 'longitude', 'timezoneOffset', 'houseSystem'])
        && data.keys().hasOnly(['name', 'birthDate', 'birthTime', 'placeName', 'latitude', 'longitude', 'timezoneOffset', 'houseSystem', 'birthTimeUnknown', 'currentLocationName', 'currentLatitude', 'currentLongitude', 'currentTimezoneId', 'currentTimezoneOffset'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.birthDate is string && data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.birthTime is string && data.birthTime.matches('^[0-9]{2}:[0-9]{2}$')
        && data.placeName is string && data.placeName.size() <= 300
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.timezoneOffset is number && data.timezoneOffset >= -14 && data.timezoneOffset <= 14
        && data.houseSystem in ['P', 'W', 'K', 'E', 'R']
        && (!('birthTimeUnknown' in data) || data.birthTimeUnknown is bool)
        && (!('currentLocationName' in data) || (data.currentLocationName is string && data.currentLocationName.size() <= 300))
        && (!('currentLatitude' in data) || (data.currentLatitude is number && data.currentLatitude >= -90 && data.currentLatitude <= 90))
        && (!('currentLongitude' in data) || (data.currentLongitude is number && data.currentLongitude >= -180 && data.currentLongitude <= 180))
        && (!('currentTimezoneId' in data) || (data.currentTimezoneId is string && data.currentTimezoneId.size() <= 100))
        && (!('currentTimezoneOffset' in data) || (data.currentTimezoneOffset is number && data.currentTimezoneOffset >= -14 && data.currentTimezoneOffset <= 14));
    }
    match /users/{uid}/private/intake {
      allow get: if owner(uid);
      allow create, update: if owner(uid) && validIntake(request.resource.data);
      allow delete: if owner(uid);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
